<div class="container py-4">

  <h3 class="mb-3 text-center">Guided Prompt</h3>

  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h5 class="text-pink mb-2">Your Prompt</h5>
      <p>{{prompt.text}}</p>
    </div>
  </div>

  <form action="/journal/guided/save" method="POST">
    <input type="hidden" name="prompt_id" value="{{prompt.id}}">
    <input type="hidden" name="feeling" value="{{prompt.feeling}}">

    <textarea name="content" 
              class="form-control mb-3"
              rows="6" 
              placeholder="Write your reflection here..."></textarea>

    <button class="btn btn-primary w-100 rounded-pill">
      Save Entry
    </button>
  </form>

</div>

<div class="journal-page-new container-fluid mt-4 px-4">
  <h2 class="mb-4 text-center fw-bold text-pink">My Journal</h2>

  <div class="row g-4">
    <div class="col-lg-6">
      
      <!-- plain entry -->
      <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-gradient-pink text-white">
          <h5 class="mb-0"><i class="bi bi-pencil-fill me-2"></i>Quick Entry</h5>
        </div>
        <div class="card-body">
          <form action="/journal/new" method="POST">
            <input type="hidden" name="type" value="quick">
            
            <div class="mb-3">
              <label for="quick-title" class="form-label fw-semibold">Title <small class="text-muted">(optional)</small></label>
              <input 
                type="text" 
                class="form-control" 
                id="quick-title" 
                name="title" 
                placeholder="Give your entry a title...">
            </div>
            
            <div class="mb-3">
              <label for="quick-content" class="form-label fw-semibold">Write your thoughts</label>
              <textarea 
                class="form-control" 
                id="quick-content" 
                name="content" 
                rows="6" 
                placeholder="What's on your mind today?" 
                required></textarea>
              <div class="form-text text-end" id="quick-char-count">0 characters</div>
            </div>
            
            <button type="submit" class="btn btn-primary w-100 py-2">
              <i class="bi bi-save me-2"></i>Save Entry
            </button>
          </form>
        </div>
      </div>

      <!-- guided entry -->
      <div class="card shadow-sm border-0">
        <div class="card-header bg-gradient-success text-white">
          <h5 class="mb-0"><i class="bi bi-lightbulb-fill me-2"></i>Guided Prompts</h5>
        </div>
        <div class="card-body">
          <p class="text-muted small mb-3">Choose a topic and prompt to guide your journaling.</p>
          
          <form action="/journal/guided" method="POST" id="guidedForm">
            <input type="hidden" name="type" value="guided">
            <input type="hidden" name="prompt_topic" id="hidden-topic">
            <input type="hidden" name="prompt_text" id="hidden-prompt">
            
            <div class="mb-3">
              <label for="topic" class="form-label fw-semibold">Choose a topic</label>
              <select class="form-select" id="topic" name="topic" required>
                <option value="">Select a topic...</option>
                <option value="anxious">Anxiety</option>
                <option value="grateful">Gratitude</option>
                <option value="goals">Goals & Growth</option>
                <option value="reflective">Self-Reflection</option>
                <option value="happy">Celebrating Wins</option>
              </select>
            </div>

            <div id="promptsContainer" class="mb-3" style="display: none;">
              <label class="form-label fw-semibold">Choose a prompt</label>
              <div id="promptsList" class="prompt-options"></div>
            </div>
            <div class="mb-3" id="responseContainer" style="display: none;">
              <label for="guidedContent" class="form-label fw-semibold">Your response</label>
              <div class="alert alert-info py-2 px-3 small" id="selectedPromptDisplay"></div>
              <textarea 
                class="form-control" 
                id="guidedContent" 
                name="content" 
                rows="6" 
                placeholder="Write your thoughts here..." 
                required></textarea>
              <div class="form-text text-end" id="guided-char-count">0 characters</div>
            </div>

            <button type="submit" class="btn btn-success w-100 py-2" id="guidedSubmit" disabled>
              <i class="bi bi-save me-2"></i>Save Guided Entry
            </button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card shadow-sm border-0 archive-card">
        <div class="card-header bg-gradient-secondary text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-journal-text me-2"></i>Entry Archive</h5>
          <span class="badge bg-white text-dark">{{entries.length}} entries</span>
        </div>
        
        <div class="card-body p-0">
          <div class="archive-scroll">
            {{#if entries}}
              <div class="list-group list-group-flush">
                {{#each entries}}
                  <div class="list-group-item archive-item" data-entry-id="{{this.id}}">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                      <div class="flex-grow-1">
                        <h6 class="mb-1 fw-bold entry-title">
                          {{#if this.title}}
                            {{this.title}}
                          {{else}}
                            Untitled Entry
                          {{/if}}
                        </h6>
                        
                        {{#if this.type}}
                          {{#if (eq this.type "guided")}}
                            <span class="badge bg-success-soft text-success small mb-2">
                              <i class="bi bi-lightbulb"></i> Guided
                            </span>
                          {{else if (eq this.type "quick")}}
                            <span class="badge bg-primary-soft text-primary small mb-2">
                              <i class="bi bi-pencil"></i> Quick Entry
                            </span>
                          {{/if}}
                        {{else}}
                          <span class="badge bg-info-soft text-info small mb-2">
                            <i class="bi bi-chat-quote"></i> Daily Prompt
                          </span>
                        {{/if}}
                      </div>
                      
                      <small class="text-muted ms-2">{{formatDate this.created_at}}</small>
                    </div>
                    
                    <p class="mb-2 text-muted small entry-preview">
                      {{truncate this.content 120}}
                    </p>
                    
                    <button 
                      class="btn btn-sm btn-outline-primary view-entry-btn"
                      data-bs-toggle="modal" 
                      data-bs-target="#entryModal"
                      data-title="{{this.title}}"
                      data-content="{{this.content}}"
                      data-date="{{formatDate this.created_at}}"
                      data-type="{{this.type}}"
                      data-prompt="{{this.prompt_text}}">
                      <i class="bi bi-eye me-1"></i>Read More
                    </button>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <div class="text-center text-muted py-5">
                <i class="bi bi-journal-x" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3">No entries yet. Start writing!</p>
              </div>
            {{/if}}
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- entry view modal -->
<div class="modal fade" id="entryModal" tabindex="-1" aria-labelledby="entryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-light">
        <div>
          <h5 class="modal-title fw-bold" id="entryModalLabel"></h5>
          <small class="text-muted" id="entryModalDate"></small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="entryModalPrompt" class="alert alert-info mb-3" style="display: none;">
          <strong>Prompt:</strong> <span id="promptText"></span>
        </div>
        <div id="entryModalContent" style="white-space: pre-wrap; line-height: 1.6;"></div>
      </div>
      <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<script src="/js/journal.js"></script>
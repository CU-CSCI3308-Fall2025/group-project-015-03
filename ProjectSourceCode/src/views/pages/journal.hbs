<div class="journal-page container mt-4">

  <h4 class="mb-4 text-center fw-bold">My Journal Entries</h4>

  <div class="journal-grid">
    {{#each entries}}
      <div class="journal-card">
        <h5 class="journal-title">{{this.title}}</h5>
        <p class="journal-text">{{this.content}}</p>
      </div>
    {{/each}}

    <!-- Add New Card -->
    <a href="/journal/new" class="journal-card add-new-card">
      <div class="add-new-inner">+ Add New Entry</div>
    </a>
  </div>

  <script src="/js/main.js"></script>
</div>

<div class="journal-page container mt-4">

  <h4 class="mb-3 text-center fw-bold">My Journal Entries</h4>

  <div class="text-center mb-4">
    <a href="/journal/new" class="btn btn-primary px-4 py-2 rounded-pill">
      + Add New Entry
    </a>
  </div>

  <div class="journal-grid">
    {{#each entries}}
      <div class="journal-card">
        <h5 class="journal-title">{{this.title}}</h5>
        <p class="journal-text">{{this.content}}</p>
      </div>
    {{/each}}
  </div>

  <script src="/js/main.js"></script>
</div>

<main class="container mt-4">
  <h4 class="mb-4 text-center">My Journal Entries</h4>

  <div class="row g-3">
    {{#each entries}}
      <div class="col-md-6">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5 class="card-title">{{this.title}}</h5>
            <p class="card-text">{{this.text}}</p>
          </div>
        </div>
      </div>
    {{/each}}

    <!-- "Add New" Card -->
    <div class="col-md-6">
      <div class="card text-center border-primary shadow-sm">
        <div class="card-body">
          <a href="/journal/new" class="btn btn-primary btn-lg w-100">+ Add New Entry</a>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/main.js"></script>
</main>

<main class="container mt-4">
  <h2 class="mb-3">Today’s Reflections</h2>

  {{!-- loop over entries passed from the server --}}
  {{#each posts}}
    <div class="card mb-3">
      <div class="card-body">
        <h5 class="card-title">{{this.username}}</h5>
        <p class="card-text">“{{this.text}}”</p>
        <button class="btn btn-outline-primary btn-sm">❤️ Like</button>
      </div>
    </div>
  {{/each}}

  {{!-- if there are no posts --}}
  {{#unless posts}}
    <p class="text-muted">No reflections yet — be the first to post!</p>
  {{/unless}}
</main>

<script src="/js/main.js"></script>

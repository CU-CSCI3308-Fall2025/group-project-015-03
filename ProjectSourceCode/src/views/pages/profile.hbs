<main class="container my-5" id="profile-page">
  <div class="text-center mb-4">
    <!-- profile pic -->
    <img id="profile-pic" src="/images/{{profilePic}}" alt="Profile Picture"
         class="rounded-circle mb-2 border border-3 border-pink" width="120" height="120" />
    <h3 class="text-pink fw-bold" id="display-username">{{username}}</h3>
    <p class="text-muted" id="display-nickname">"{{nickname}}"</p>

    <form id="profile-pic-form" method="POST" action="/profile/picture" enctype="multipart/form-data">
      <label for="profile-pic-input" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-camera"></i> Change Picture
      </label>
      <input type="file" id="profile-pic-input" name="pfp" accept="image/*" class="d-none" onchange="this.form.submit()" />
    </form>
  </div>

  <div class="mx-auto" style="max-width: 600px;">
    <!-- profile view -->
    <div id="profile-view">
      <p><strong>Pronouns:</strong> <span id="display-pronouns">{{pronouns}}</span></p>
      <p><strong>Personal Quote:</strong> <span id="display-quote">{{quote}}</span></p>
      <p><strong>Spotify:</strong> <span class="text-muted">{{spConnected}}</span></p>

      <div class="mt-4 d-flex justify-content">
        <button class="btn btn-outline-primary w-50 me-2" id="edit-btn">Edit Profile</button>
        <form action="/logout" method="GET" class="w-100">
          <button type="submit" class="btn btn-primary w-50 me-2">Logout</button>
        </form>
      </div>
    </div>

    <!-- editing -->
    <form id="profile-edit" class="d-none" method="POST" action="/profile/edit">
      <div class="mb-3">
        <label for="nickname" class="form-label text-pink fw-semibold">Nickname</label>
        <input type="text" class="form-control" id="nickname" name="nickname" value="{{nickname}}" />
      </div>
      <div class="mb-3">
        <label for="pronouns" class="form-label text-pink fw-semibold">Pronouns</label>
        <input type="text" class="form-control" id="pronouns" name="pronouns" value="{{pronouns}}" />
      </div>
      <div class="mb-3">
        <label for="quote" class="form-label text-pink fw-semibold">Personal Quote</label>
        <textarea class="form-control" id="quote" name="quote" rows="2">{{quote}}</textarea>
      </div>

      <div class="mb-3">
        <label class="form-label fw-semibold text-pink d-block">Spotify</label>
        <button type="button" id="spotify_login" class="btn btn-prompt">Connect Spotify</button>
        <script src="/js/spotify_login.js"></script>
      </div>

      <div class="text-center mt-5"> 
        <label class="form-label fw-semibold text-pink me-2">Theme:</label> 
        <select id="theme-select" name="theme" class="form-select d-inline-block" style="width: 200px;"> 
          <option value="pink" selected>Pink</option> 
          <option value="lavender">Lavender</option> 
          <option value="blue">Blue</option> 
        </select> 
    </div>

      <div class="d-flex justify-content-between mt-3">
        <button type="button" class="btn btn-outline-secondary w-50 me-2" id="cancel-edit">Cancel</button>
        <button type="submit" class="btn btn-prompt w-50 ms-2">Save Changes</button>
      </div>
    </form>
  </div>
</main>

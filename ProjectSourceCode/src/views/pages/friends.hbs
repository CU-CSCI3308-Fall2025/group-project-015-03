<main class="container mt-5">
  <h2 class="mb-4 text-center">Friends</h2>

  <!-- search -->
  <div class="row mb-4 justify-content-center">
    <div class="col-md-6">
      <input type="text" id="friendSearch" class="form-control" placeholder="Search for friends...">
    </div>
  </div>

  <div id="friendsGrid" class="row g-4 text-center text-muted">
    <p>Start typing to search for friends</p>
  </div>

  <!-- friend list -->
  <div class="mt-5">
    <h4>Your Friends</h4>
    <ul id="friendList" class="list-group">
      {{#each results}}
        <li class = "list-group-item">{{this.friend}}</li>  
      {{/each}}
    </ul>
  </div>
</main>

<!-- friend modal -->
<div class="modal fade" id="friendModal" tabindex="-1" aria-labelledby="friendModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="friendModalLabel">Friend Profile</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center">
        <img id="modalProfileImg" src="/images/profile-placeholder.png" class="rounded-circle mb-3" width="100" />
        <h5 id="modalName"></h5>
        <p class="text-muted">@<span id="modalUsername"></span></p>
        <blockquote class="fst-italic" id="modalQuote"></blockquote>
      </div>
      <div class="modal-footer justify-content-center">
        <button id="addFriendBtn" class="btn btn-primary">Add Friend</button>
      </div>
    </div>
  </div>
</div>

<script src="/js/main.js"></script>
